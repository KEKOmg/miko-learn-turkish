    "grammar.question-words.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turkish question words: Ne? (What?), Kim? (Who?), Nerede? (Where?), Nasıl? (How?), Ne zaman? (When?), Neden? (Why?)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В турецком языке: Ne? (Что?), Kim? (Кто?), Nerede? (Где?), Nasıl? (Как?), Ne zaman? (Когда?), Neden? (Почему?)."
          }
        }
      },
      "shouldTranslate" : false
    },
