    "grammar.accusative-case.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A specific object takes the suffix: Bu filmi seviyorum — \"I love this film\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конкретный объект получает суффикс: Bu filmi seviyorum — «Я люблю этот фильм»."
          }
        }
      }
    },
    "grammar.accusative-case.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accusative case: -ı/-i/-u/-ü"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Винительный падеж: -ı/-i/-u/-ü"
          }
        }
      }
    },
    "grammar.body-ailments.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Body part + possessive + ağrıyor: başım ağrıyor — \"my head hurts\"; dişim ağrıyor — \"my tooth hurts\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часть тела + притяжательный + ağrıyor: başım ağrıyor — «болит голова»; dişim ağrıyor — «болит зуб»."
          }
        }
      }
    },
    "grammar.body-ailments.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ailments: başım ağrıyor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что болит: başım ağrıyor"
          }
        }
      }
    },
    "grammar.clock-time.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat üç = \"three o’clock\". Point in time: -de/-da/-te/-ta: yedide kalkıyorum — \"I get up at seven\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat üç = «три часа». Момент времени: -de/-da/-te/-ta: yedide kalkıyorum — «встаю в семь»."
          }
        }
      }
    },
    "grammar.clock-time.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telling time: saat kaç?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Который час: saat kaç?"
          }
        }
      }
    },
    "grammar.comparison-daha.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More: daha sıcak — \"warmer\". Comparison: Yaz, kıştan daha sıcak. Most: en güzel — \"the most beautiful\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более: daha sıcak — «теплее». Сравнение: Yaz, kıştan daha sıcak. Наиболее: en güzel — «самый красивый»."
          }
        }
      }
    },
    "grammar.comparison-daha.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparison: daha / en"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнение: daha / en"
          }
        }
      }
    },
    "grammar.copula-suffixes.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The verb 'to be' is expressed through personal suffixes: -im, -sin, -dir, -iz, -siniz, -dirler. E.g. Ben doktorum (I am a doctor)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глагол 'быть' в турецком выражается личными суффиксами: -im, -sin, -dir, -iz, -siniz, -dirler. Например: Ben doktorum (Я врач)."
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.copula-suffixes.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copula Suffixes"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суффиксы-связки"
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.direction-cases.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use -(y)a/-(y)e for movement toward a place and -dan/-den/-tan/-ten for movement from it. The form follows vowel harmony."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для движения куда-то используйте -(y)a/-(y)e, а для движения откуда-то — -dan/-den/-tan/-ten. Форма суффикса подчиняется гармонии гласных."
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.direction-cases.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where to and where from"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Куда и откуда"
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.genitive-chain.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whose? Pattern: annemin arabası — \"mom’s car\": the first word takes -(n)in, the second a possessive suffix."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чей? Конструкция: annemin arabası — «машина мамы»: первое слово получает -(n)in, второе — притяжательный суффикс."
          }
        }
      }
    },
    "grammar.genitive-chain.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possession: -(n)in … -(s)i"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принадлежность: -(n)in … -(s)i"
          }
        }
      }
    },
    "grammar.locative-case.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The suffix -da/-de/-ta/-te answers “where?”. After proper names it is separated by an apostrophe: Minsk'te, İstanbul'da."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суффикс -da/-de/-ta/-te отвечает на вопрос «где?». После имён собственных он отделяется апострофом: Minsk'te, İstanbul'da."
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.locative-case.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where? Locative case"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Где? Местный падеж"
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.personal-pronouns.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turkish personal pronouns: ben (I), sen (you), o (he/she), biz (we), siz (you pl.), onlar (they)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В турецком языке личные местоимения: ben (я), sen (ты), o (он/она), biz (мы), siz (вы), onlar (они)."
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.personal-pronouns.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal Pronouns"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Личные местоимения"
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.plural-suffix.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By vowel harmony: kitaplar (books), gömlekler (shirts). Not used after numbers: iki kitap."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По гармонии гласных: kitaplar (книги), gömlekler (рубашки). После чисел не используется: iki kitap."
          }
        }
      }
    },
    "grammar.plural-suffix.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plural: -ler/-lar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Множественное число: -ler/-lar"
          }
        }
      }
    },
    "grammar.polite-imperative.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A polite instruction uses the suffix -(y)in/-(y)ın/-(y)un/-(y)ün: gidin (go), dönün (turn)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вежливое указание образуется суффиксом -(y)in/-(y)ın/-(y)un/-(y)ün: gidin (идите), dönün (поверните)."
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.polite-imperative.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polite directions"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вежливые указания"
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.possessive-suffixes.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possessive suffixes show who something belongs to. For “my”, add -(i)m/-(ı)m/-(u)m/-(ü)m: anne → annem, aile → ailem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Притяжательные суффиксы показывают принадлежность. Для «мой/моя» добавляется -(i)m/-(ı)m/-(u)m/-(ü)m: anne → annem, aile → ailem."
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.possessive-suffixes.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My family: possessive suffixes"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моя семья: притяжательные суффиксы"
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.present-continuous.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Action in progress: gelmek → geliyor (he/she is coming). Yağmur yağıyor — \"it is raining\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действие сейчас: gelmek → geliyor (он идёт). Yağmur yağıyor — «идёт дождь»."
          }
        }
      }
    },
    "grammar.present-continuous.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Present continuous: -iyor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настоящее длительное: -iyor"
          }
        }
      }
    },
    "grammar.present-tense.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Present tense uses suffix -iyor/-ıyor/-uyor/-üyor + personal ending. E.g. ben geliyorum (I am coming)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настоящее время образуется с помощью суффикса -iyor/-ıyor/-uyor/-üyor + личное окончание. Например: ben geliyorum (я прихожу)."
          }
        }
      },
      "shouldTranslate" : false
    },
