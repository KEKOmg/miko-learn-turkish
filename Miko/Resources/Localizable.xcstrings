          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гармония гласных"
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.wish-want.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Infinitive + istemek: gitmek istiyorum — \"I want to go\". Negative: gitmek istemiyorum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инфинитив + istemek: gitmek istiyorum — «я хочу пойти». Отрицание: gitmek istemiyorum."
          }
        }
      }
    },
