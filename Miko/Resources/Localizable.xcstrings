    "grammar.var-yok.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var means something exists or is available; yok means it does not. With a possessive form: kardeşim var (I have a sibling)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var означает, что что-то есть, а yok — что этого нет. С притяжательной формой: kardeşim var (у меня есть брат или сестра)."
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.var-yok.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is and there isn't"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть и нет: var / yok"
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.vowel-harmony.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vowels in suffixes adapt to the last vowel of the root: e-type (e, i, ö, ü) or a-type (a, ı, o, u). E.g. ev-de (at home), kitap-ta (in the book)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В турецком языке гласные в суффиксах подстраиваются под последнюю гласную корня: e-тип (e, i, ö, ü) или a-тип (a, ı, o, u). Например: ev-de (дома), kitap-ta (в книге)."
          }
        }
      },
      "shouldTranslate" : false
    },
    "grammar.vowel-harmony.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
