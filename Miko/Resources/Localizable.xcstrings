          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Базовый порядок слов в турецком: Подлежащее — Дополнение — Сказуемое (SOV). Глагол всегда в конце."
          }
        }
      },
      "shouldTranslate" : false
    },
